// Default: publish nothing; each process opts in below.
process {
    publishDir = [ enabled: false ]

    // skiver dump: subsampling / extra flags (see params.skiver_dump_args). Closures
    // so `-c`-file param overrides (resolved after config parse) are honoured.
    withName: 'SKIVER_DUMP' {
        ext.args = { params.skiver_dump_args }
    }

    // Trained error model + Phred calibration + AIC table, once per sample.
    withName: 'SKIVER_TRAIN' {
        publishDir = [
            path: { "${params.outdir}/error_models/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    // Human-readable error-model diagnostic HTML, alongside the model.
    withName: 'SKIVER_REPORT' {
        publishDir = [
            path: { "${params.outdir}/error_models/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    // In-silico PCR: the mapseq reference set + translation table.
    withName: 'EXTRACT_AMPLICONS' {
        ext.args = { [
            params.fwd_primer ? "--fwd-primer ${params.fwd_primer}" : '',
            params.rev_primer ? "--rev-primer ${params.rev_primer}" : '',
            "--primer-mismatches ${params.primer_mismatches}",
        ].findAll { it }.join(' ') }
        storeDir = { params.amplicon_cache ? "${params.amplicon_cache}/${meta.id}/amplicons" : null }
    }

    // --amplicon_cache: one extraction + clustering per reference set, shared by every run
    // pointed at it (meta.id is the set's cache key, see the workflow). The mapseq build
    // is keyed by its version too. Neither runs for a prebuilt database, and the
    // clustering runs only under --build_mapseq_db.
    // ponytail: storeDir is unlocked. Runs that start cold on the same set at once each
    // build it and the last to finish replaces it - identical files, but a task staging
    // them in that moment can fail. Warm the cache with one run first.
    withName: 'MAPSEQ_CLUSTER' {
        storeDir = { params.amplicon_cache ? "${params.amplicon_cache}/${meta.id}/mapseq_${params.mapseq_tag}" : null }
    }

    // The extracted reference set is built once per distinct reference FASTA, as a shared
    // refs_<digest>_amplicons dir. MATRIX_KEY is the first per-sample task holding it, so
    // it publishes that dir under each sample's own amplicons/<id>_amplicons.
    withName: 'MATRIX_KEY' {
        publishDir = [
            path: { "${params.outdir}/amplicons" },
            mode: params.publish_dir_mode,
            pattern: 'refs_*_amplicons',
            saveAs: { fn -> "${meta.id}_amplicons" }
        ]
    }

    // Simulated reads: the sampling depth and error model behind M.
    withName: 'SIMULATE_READS|SIMULATE_PANEL_READS' {
        ext.args = { [
            "--error-model ${params.sim_error_model}",
            "--n-per-ref ${task.process.endsWith('SIMULATE_PANEL_READS') ? params.panel_sim_n_per_ref : params.sim_n_per_ref}",
            params.sim_read_len ? "--read-len ${params.sim_read_len}" : '',
            // The same primer trim READS_TO_FASTA gives the observed reads.
            params.trim_primers.toString() == 'true' ? "--trim-primers --primer-mismatches ${params.primer_mismatches}" : '',
            params.trim_primers.toString() == 'true' && params.fwd_primer ? "--fwd-primer ${params.fwd_primer}" : '',
            params.trim_primers.toString() == 'true' && params.rev_primer ? "--rev-primer ${params.rev_primer}" : '',
            params.sim_error_model == 'flat' ? "--sub-rate ${params.flat_sub_rate}" : '',
            params.sim_error_model == 'flat' ? "--ins-rate ${params.flat_ins_rate}" : '',
            params.sim_error_model == 'flat' ? "--del-rate ${params.flat_del_rate}" : '',
        ].findAll { it }.join(' ') }
    }

    withName: 'MINIMAP2_INDEX' {
        ext.args = { params.minimap2_index_args }
    }
    withName: 'MINIMAP2_ALLVSALL' {
        ext.args = { params.minimap2_args }
    }

    // Alignment-built M describes whole-reference queries only. `sim_read_len` belongs to
    // the simulate path; the workflow refuses it here rather than passing it along.
    withName: 'ALIGN_MISMAPPING' {
        ext.args = { [
            "--tau ${params.align_tau}",
            "--distance-decay ${params.align_distance_decay}",
            "--ambiguity-weight ${params.align_ambiguity_weight}",
            // Read only by '--distance-decay auto', which measures the error model
            // rather than taking the decay on trust.
            "--sub-rate ${params.flat_sub_rate}",
            "--ins-rate ${params.flat_ins_rate}",
            "--del-rate ${params.flat_del_rate}",
        ].join(' ') }
    }

    // Observed reads -> mapseq input. Primers are trimmed with the same primers used for
    // the references, so reads land in the reference amplicons' coordinate space. No-op
    // on reads that are already trimmed.
    withName: 'READS_TO_FASTA' {
        ext.args = { [
            // Paired mates are merged into one query per fragment: a 150bp mate mapped
            // against a 253bp amplicon sees only part of it, and the mis-mapping matrix
            // built from whole amplicons would not describe that.
            meta.paired ? "--paired --min-overlap ${params.min_pair_overlap}" : '',
            // toString(): a command-line `--trim_primers false` arrives as the truthy String "false".
            params.trim_primers.toString() == 'true' ? '' : '--no-trim-primers',
            params.fwd_primer ? "--fwd-primer ${params.fwd_primer}" : '',
            params.rev_primer ? "--rev-primer ${params.rev_primer}" : '',
            "--primer-mismatches ${params.primer_mismatches}",
            "--max-reads ${params.obs_max_reads}",
        ].findAll { it }.join(' ') }
    }

    // Both mappings must use identical settings — that is what makes M the confusion the
    // real reads actually experience.
    withName: 'MAPSEQ.*' {
        ext.args = { params.mapseq_args }
    }
    withName: 'MAPSEQ_SIM|MAPSEQ_PANEL_SIM' { ext.prefix = { "${meta.id}.sim" } }
    withName: 'MAPSEQ_PANEL_HOME' { ext.prefix = { "${meta.id}.home" } }
    withName: 'MAPSEQ_HOME' { ext.prefix = { "${meta.id}.home" } }
    withName: 'HOME_PROBES' {
        ext.args = { "--home-probes ${params.align_home_probes} --seed ${params.seed}" }
    }

    // Panel sources are cut with the same in-silico PCR as the references.
    withName: 'PANEL_PREPARE' {
        ext.args = { [
            params.fwd_primer ? "--fwd-primer ${params.fwd_primer}" : '',
            params.rev_primer ? "--rev-primer ${params.rev_primer}" : '',
            "--max-mismatch ${params.primer_mismatches}",
            "--max-taxon-sources ${params.panel_taxon_max_sources}",
        ].findAll { it }.join(' ') }
    }
    withName: 'PANEL_KERNEL' {
        ext.args = { [
            params.mapseq_min_identity != null ? "--min-identity ${params.mapseq_min_identity}" : '',
            meta.panel ? "--provenance panel=${meta.panel}" : '',
            meta.panel_taxa ? "--provenance panel_taxa=${meta.panel_taxa}" : '',
            "--provenance matrix_key=${meta.matrix_key}",
            "--provenance sim_error_model=${params.sim_error_model}",
            "--provenance model_identity=${meta.model_identity}",
            "--provenance n_per_source=${params.panel_sim_n_per_ref}",
            params.sim_error_model == 'flat'
                ? "--provenance flat_rates=${params.flat_sub_rate}/${params.flat_ins_rate}/${params.flat_del_rate}" : '',
            "--provenance mapseq_tag=${params.mapseq_tag}",
            "--provenance seed=${params.seed}",
        ].findAll { it }.join(' ') }
        publishDir = [
            path: { "${params.outdir}/mismapping" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }
    withName: 'MAPSEQ_OBS' {
        ext.prefix = { "${meta.id}.obs" }
        publishDir = [
            path: { "${params.outdir}/mapseq/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.mseq.gz'
        ]
    }

    // Build M with the same identity threshold used to count observed mapseq hits.
    withName: 'BUILD_MISMAPPING' {
        ext.args = {
            params.mapseq_min_identity != null ? "--min-identity ${params.mapseq_min_identity}" : ''
        }
    }

    // Composition inference outputs (incl. the measured mis-mapping matrix).
    withName: 'INFER_COMPOSITION' {
        ext.args = { [
            "--mode ${params.infer_mode}",
            "--alpha ${params.infer_alpha}",
            "--steps ${params.infer_steps}",
            "--lr ${params.infer_lr}",
            "--num-samples ${params.infer_num_samples}",
            "--warmup ${params.infer_warmup}",
            "--min-infer-reads ${params.min_infer_reads}",
            "--infer-space ${params.infer_space}",
            // toString(): a command-line `--infer_presence false` arrives as the truthy String "false".
            params.infer_presence.toString() == 'true' ? "--presence-prior ${params.infer_presence_prior}" : '--no-presence',
            params.infer_presence.toString() == 'true' ? "--presence-temp ${params.infer_presence_temp}" : '',
            params.infer_horseshoe.toString() == 'true' ? '--horseshoe' : '',
            params.mapseq_min_identity != null ? "--min-identity ${params.mapseq_min_identity}" : '',
            params.infer_prune.toString() == 'true' ? '' : '--no-prune',
            params.infer_distance_decay.toString() == 'true' ? "--infer-distance-decay --decay-sigma ${params.infer_decay_sigma}" : '',
        ].findAll { it }.join(' ') }
        publishDir = [
            path: { "${params.outdir}/composition/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    // Posterior-predictive fit check. The check consumes the same observed MAPseq table
    // and canonical matrix used for inference, so it cannot be substituted by a mapper
    // top-hit summary.
    withName: 'CHECK_COMPOSITION_FIT' {
        ext.args = { [
            "--min-infer-reads ${params.min_infer_reads}",
            params.mapseq_min_identity != null ? "--min-identity ${params.mapseq_min_identity}" : '',
        ].findAll { it }.join(' ') }
        publishDir = [
            path: { "${params.outdir}/composition/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'PUBLISH_MISMAPPING' {
        publishDir = [
            path: { "${params.outdir}/mismapping" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> (fn.equals('versions.yml') || fn.endsWith('.group.tsv')) ? null : fn }
        ]
    }
}
