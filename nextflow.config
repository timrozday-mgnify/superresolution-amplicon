params {
    // Required inputs
    input            = null   // YAML samplesheet (list of sample entries)
    references       = null   // default reference fasta (per-sample override via samplesheet)
    outdir           = './results'

    // Publishing
    publish_dir_mode = 'copy'

    // Reproducibility
    seed             = 42

    // Default sequencing platform (skiver error-model context + report notebook).
    // One of: hq-illumina | lq-illumina | ont | pacbio. Per-sample overridable.
    platform         = 'hq-illumina'

    // Optional global pre-trained error model (skips training). Per-sample override
    // via the samplesheet 'error_model' column.
    error_model      = null

    // When simulated reads use a trained error model, retain historical per-sample
    // fitting or train one deterministic pooled model per sequencing platform.
    trained_error_model_scope = 'per-sample' // per-sample | pooled
    trained_error_model_max_reads = 1000000  // pooled mode: 0 = all records

    // Extra flags forwarded to `skiver dump`. Amplicon inputs are often small, so
    // skiver's size-based auto-subsampling can pick a large rate and keep too few
    // k-mers; pass e.g. '-c 1' (no subsampling) for small/high-coverage data.
    skiver_dump_args = ''

    // --- Error-model architecture (skiver context model) ----------------------
    // Candidate component strings fitted by skiver; the min-AIC model is kept. The
    // context order (5/7/9) is the key architecture dial.
    error_model_candidates = 'AdditiveContext(5),AdditiveContext(7),AdditiveContext(9)'
    // Override: force a single component string (skips AIC selection).
    error_model_components = null

    // --- Reference amplicons (in-silico PCR) ----------------------------------
    // Amplicon primers (default V4 515F/806R, baked into subspecies_infer defaults).
    fwd_primer         = null   // null => script default (GTGYCAGCMGCCGCGGTAA)
    rev_primer         = null   // null => script default (GGACTACNVGGGTWTCTAAT)
    primer_mismatches  = 3
    trim_primers       = true   // trim primers off observed reads before mapping (uses
                                // fwd/rev_primer); set false if reads are already trimmed

    // --- Mis-mapping ----------------------------------------------------------
    // How M is built.
    // 'simulate' = sample errored reads from every reference and map them with the same
    //              mapper the real reads go through. M is *measured*.
    // 'align'    = align the reference amplicons to each other and read M off the
    //              distances: a read from reference `a` is assigned uniformly over the
    //              references within `align_tau` edit operations of it. No mapper, no
    //              error model, no skiver training; ~460x cheaper. On the 21-genome
    //              B. uniformis V4 set it sits inside the simulate path's own
    //              seed-to-seed noise floor and fits the confusable pair at least as
    //              well (dev/alignment_mismapping.md). Opt-in rather than the default:
    //              that DB's confusion is 90% *exact* duplicate amplicons, and a
    //              reference set differing by one or two bases is where a distance-only
    //              M is expected to miss.
    mismapping_method  = 'simulate'   // simulate | align
    align_tau          = 0      // 'align': cluster references within this edit distance.
                                // 0 (exact duplicates) beat every larger value tested;
                                // tau>0 was decisively worse, not softer.
    // minimap2   = all-vs-all PAF, re-scored for IUPAC. Reference-square M; fine to a
    //              few thousand references, quadratic beyond.
    // exact-hash = group byte-identical amplicons only (tau must be 0). Streaming, one
    //              pass, no alignment at all: the whole 1M-reference GTDB SSU set in a
    //              couple of seconds and under 0.5 GB.
    // kmer       = exact-hash widened to tau>=1 by a pigeonhole block filter over the
    //              *distinct* amplicons, verified with a bounded IUPAC edit distance.
    // The last two write the grouped matrix (sparse_matrix.write_grouped): duplicate
    // groups are stored once instead of once per reference pair, which is the difference
    // between 10 MB and 290 GB on GTDB SSU.
    align_backend      = 'minimap2' // minimap2 | exact-hash | kmer
    max_ambiguous_bases = 4     // 'kmer': IUPAC positions a pair may carry between them
                                // before the pigeonhole filter may miss it. Each one
                                // costs a block, shortening the blocks and widening the
                                // search, so this is a cost/recall knob.
    max_postings       = 4096   // 'kmer': skip a block shared by more than this many
                                // distinct amplicons. Conserved windows either side of
                                // the variable region are quadratic to enumerate and add
                                // nothing a rarer block does not; this is the filter's
                                // only source of false negatives.
    // Align always uses an indexed minimap2 all-vs-all. No preset, small minimizers, no
    // score-ratio filter, and -c for CIGAR: the settings that
    // returned the most complete set of pairs in that benchmark.
    minimap2_args      = '-p 0 -N 1000 --secondary=yes -c'
    // -k/-w live in the prebuilt index (minimap2 ignores them on the command line when
    // the target is a .mmi), so they are set here and must not be repeated above.
    minimap2_index_args = '-k 11 -w 5'
    align_ambiguity_weight = 0.3 // 'align': a cluster member carrying k IUPAC ambiguity
                                // codes takes w**k of a uniform share, because mapseq
                                // scores an N as a mismatch and prefers a clean duplicate.
                                // A no-op on reference sets without ambiguity codes; 1
                                // disables. See dev/ambiguity_weight_sweep.md — the real
                                // penalty varies (0.18-0.97), so this is a compromise.

    // Read length. 'simulate' only: reads shorter than the amplicon see only a window of
    // it, so references differing outside that window are indistinguishable. 'align'
    // builds M from whole-reference alignments and refuses this rather than understating
    // confusion. null => reads span the whole amplicon (correct for merged V4 reads).
    sim_read_len       = null

    // The rest of this block applies to mismapping_method = 'simulate' only.
    // 'flat'    = a constant per-base probability per mutation type, no training at all.
    // 'trained' = the skiver context error model (runs the training subworkflow).
    // Default is 'flat': across a 500x range of flat rates M is indistinguishable from
    // the trained-model M (below the seed-to-seed noise floor) and the inferred
    // composition is unaffected — amplicon confusion is driven by near-identical
    // references, not by sequencing error. See dev/error_rate_sensitivity.md.
    sim_error_model    = 'flat'
    flat_sub_rate      = 0.005  // flat model: per-base substitution probability
    flat_ins_rate      = 0.0005 // flat model: per-base insertion probability
    flat_del_rate      = 0.0005 // flat model: per-base deletion probability
    sim_n_per_ref      = 500    // simulated reads per reference (sampling depth for M)
    // Existing mismapping_matrix.csv to reuse. It must have the reference amplicon IDs
    // as both rows and columns; when set, simulation and simulated-read mapseq are skipped.
    mismapping_matrix  = null

    // --- Read mapping (mapseq) ------------------------------------------------
    mapseq_args        = ''     // extra flags forwarded to every mapseq invocation
    mapseq_min_identity = null  // drop hits below this pairwise identity (off-target
                                // background); null => keep every hit
    // Paired samples (samplesheet fastq_1+fastq_2, or 'paired: true'): R1/R2 are merged
    // into one query per fragment before mapping, so each query spans the amplicon the way
    // the reference set does. Shortest mate overlap accepted for a merge.
    min_pair_overlap   = 20

    obs_max_reads      = 100000 // fragments mapped per sample (0 = all). Detecting a
                                // low-abundance subspecies is a small-excess subtraction,
                                // so depth matters.

    // --- Composition inference (Pyro) -----------------------------------------
    infer_mode         = 'vi'   // vi | nuts | mle
    infer_alpha        = 0.5    // Dirichlet prior concentration
    infer_steps        = 3000   // SVI steps (vi/mle)
    infer_lr           = 0.02
    infer_num_samples  = 500
    infer_warmup       = 500    // nuts warmup

    // Presence/absence: a per-genome Bernoulli gate on theta, reported as
    // 'presence_prob'. The prior probability is the sparsity regulariser — a genome has
    // to earn its place against it — and is what makes the reference DB's absent genomes
    // report as absent instead of as a small non-zero tail. Chosen by Jaccard against a
    // subset-present truth; see dev/presence_prior_sweep.md. Not supported with
    // infer_mode = 'nuts'.
    infer_presence       = true
    infer_presence_prior = 0.01
    infer_presence_temp  = 1.0

    // Fit only the genomes the reads can reach: those owning a reference with at least
    // one read, or a reference byte-identical to one (mapseq broke that tie arbitrarily).
    // Everything else enters the fit as an empty row and column. At database scale that
    // is nearly the whole reference set, and dominates the cost of every sample.
    // Pruned genomes are still reported, at zero. Set false to fit the whole set.
    infer_prune          = true

    // Container image tags
    sra_skiver_tag     = 'latest'
    mapseq_tag         = '2.1.1b--hc47f52e_1'
    minimap2_tag       = '2.28--he4a0461_3'

    // Resource limits (overridden by HPC/cloud profiles)
    max_cpus         = 16
    max_memory       = '128.GB'
    max_time         = '240.h'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
}

manifest {
    name            = 'superresolution-amplicon'
    description     = 'Error-model-driven sub-species genome composition inference from amplicon reads'
    version         = '0.1.0'
    nextflowVersion = '>=25.0'
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}
