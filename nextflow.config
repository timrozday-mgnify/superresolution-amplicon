params {
    // Required inputs
    input            = null   // YAML samplesheet (list of sample entries)
    references       = null   // default reference fasta (per-sample override via samplesheet)
    outdir           = './results'

    // Publishing
    publish_dir_mode = 'copy'

    // Reproducibility
    seed             = 42

    // Default sequencing platform (skiver error-model context + report notebook).
    // One of: hq-illumina | lq-illumina | ont | pacbio. Per-sample overridable.
    platform         = 'hq-illumina'

    // Optional global pre-trained error model (skips training). Per-sample override
    // via the samplesheet 'error_model' column.
    error_model      = null

    // Extra flags forwarded to `skiver dump`. Amplicon inputs are often small, so
    // skiver's size-based auto-subsampling can pick a large rate and keep too few
    // k-mers; pass e.g. '-c 1' (no subsampling) for small/high-coverage data.
    skiver_dump_args = ''

    // --- Error-model architecture (skiver context model) ----------------------
    // Candidate component strings fitted by skiver; the min-AIC model is kept. The
    // context order (5/7/9) is the key architecture dial.
    error_model_candidates = 'AdditiveContext(5),AdditiveContext(7),AdditiveContext(9)'
    // Override: force a single component string (skips AIC selection).
    error_model_components = null

    // --- Reference amplicons (in-silico PCR) ----------------------------------
    // Amplicon primers (default V4 515F/806R, baked into subspecies_infer defaults).
    fwd_primer         = null   // null => script default (GTGYCAGCMGCCGCGGTAA)
    rev_primer         = null   // null => script default (GGACTACNVGGGTWTCTAAT)
    primer_mismatches  = 3
    trim_primers       = true   // trim primers off observed reads before mapping (uses
                                // fwd/rev_primer); set false if reads are already trimmed

    // --- Mis-mapping (simulate reads -> map with mapseq) ----------------------
    // 'flat'    = a constant per-base probability per mutation type, no training at all.
    // 'trained' = the skiver context error model (runs the training subworkflow).
    // Default is 'flat': across a 500x range of flat rates M is indistinguishable from
    // the trained-model M (below the seed-to-seed noise floor) and the inferred
    // composition is unaffected — amplicon confusion is driven by near-identical
    // references, not by sequencing error. See dev/error_rate_sensitivity.md.
    sim_error_model    = 'flat'
    flat_sub_rate      = 0.005  // flat model: per-base substitution probability
    flat_ins_rate      = 0.0005 // flat model: per-base insertion probability
    flat_del_rate      = 0.0005 // flat model: per-base deletion probability
    sim_n_per_ref      = 500    // simulated reads per reference (sampling depth for M)
    sim_read_len       = null   // null => simulate the whole amplicon (merged reads);
                                // set for unmerged/short reads

    // --- Read mapping (mapseq) ------------------------------------------------
    mapseq_args        = ''     // extra flags forwarded to every mapseq invocation
    mapseq_min_identity = null  // drop hits below this pairwise identity (off-target
                                // background); null => keep every hit
    obs_max_reads      = 100000 // reads mapped per sample (0 = all). Detecting a
                                // low-abundance subspecies is a small-excess subtraction,
                                // so depth matters.

    // --- Composition inference (Pyro) -----------------------------------------
    infer_mode         = 'vi'   // vi | nuts | mle
    infer_alpha        = 0.5    // Dirichlet prior concentration
    infer_steps        = 3000   // SVI steps (vi/mle)
    infer_lr           = 0.02
    infer_num_samples  = 500
    infer_warmup       = 500    // nuts warmup

    // Container image tags
    sra_skiver_tag     = 'latest'
    mapseq_tag         = '2.1.1b--hc47f52e_1'

    // Resource limits (overridden by HPC/cloud profiles)
    max_cpus         = 16
    max_memory       = '128.GB'
    max_time         = '240.h'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
}

manifest {
    name            = 'superresolution-amplicon'
    description     = 'Error-model-driven sub-species genome composition inference from amplicon reads'
    version         = '0.1.0'
    nextflowVersion = '>=25.0'
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}
