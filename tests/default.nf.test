nextflow_pipeline {
    name "Test Pipeline SUPERRESOLUTION_AMPLICON"
    script "main.nf"

    tag "pipeline"

    test("single sample, flat error model (default) - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/assets/samplesheet.example.yml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 1 sample: extraction, reference fingerprinting, observed mapping,
                // a canonical matrix build/publish path, and inference = 11.
                // No SKIVER_*: the error model is only used by the read simulator.
                { assert workflow.trace.succeeded().size() == 11 },
                { assert workflow.trace.tasks().every { !it.name.contains('SKIVER') } },
                { assert path("${params.outdir}/composition/demo/demo.inferred_composition.csv").exists() },
                { assert path("${params.outdir}/amplicons/demo_amplicons").exists() },
                { assert path("${params.outdir}/mapseq/demo/demo.obs.mseq.gz").exists() }
            )
        }
    }

    test("a supplied mseq skips read mapping - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/data/samplesheet.supplied_mseq.yml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // The default single-sample run is 11 tasks; supplying the classification
                // drops READS_TO_FASTA and MAPSEQ_OBS.
                { assert workflow.trace.succeeded().size() == 9 },
                { assert workflow.trace.tasks().every { !it.name.contains('MAPSEQ_OBS') } },
                { assert workflow.trace.tasks().every { !it.name.contains('READS_TO_FASTA') } },
                { assert path("${params.outdir}/composition/demo/demo.inferred_composition.csv").exists() },
                { assert !path("${params.outdir}/mapseq/demo").exists() }
            )
        }
    }

    test("trained error model adds the skiver subworkflow - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input           = "${projectDir}/assets/samplesheet.example.yml"
                outdir          = "$outputDir"
                sim_error_model = "trained"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // + SKIVER_DUMP + SKIVER_TRAIN + SKIVER_REPORT = 14
                { assert workflow.trace.succeeded().size() == 14 }
            )
        }
    }

    test("paired samples merge their mates into one query - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/data/samplesheet.paired.yml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().size() == 11 },
                { assert workflow.trace.tasks().any { it.name.contains('READS_TO_FASTA') } },
                { assert path("${params.outdir}/mapseq/paired_demo/paired_demo.obs.mseq.gz").exists() }
            )
        }
    }

    test("alignment-built M replaces the whole simulation flow - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input             = "${projectDir}/assets/samplesheet.example.yml"
                outdir            = "$outputDir"
                mismapping_method = "align"
                // Even asking for a trained model must not train one: nothing simulates
                // reads, so nothing needs an error model.
                sim_error_model   = "trained"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // Indexed minimap2 + PAF parsing replace SIMULATE_READS +
                // MAPSEQ_CLUSTER_MATRIX + MAPSEQ_SIM + BUILD_MISMAPPING: 11 - 4 + 3 = 10.
                { assert workflow.trace.succeeded().size() == 10 },
                { assert workflow.trace.tasks().every { !it.name.contains('SIMULATE') } },
                { assert workflow.trace.tasks().every { !it.name.contains('SKIVER') } },
                { assert workflow.trace.tasks().any { it.name.contains('ALIGN_MISMAPPING') } },
                { assert workflow.trace.tasks().any { it.name.contains('MINIMAP2_INDEX') } },
                { assert workflow.trace.tasks().any { it.name.contains('MINIMAP2_ALLVSALL') } },
                { assert path("${params.outdir}/mismapping/groups.tsv").exists() }
            )
        }
    }

    test("exact-hash builds M with no mapper at all - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input             = "${projectDir}/assets/samplesheet.example.yml"
                outdir            = "$outputDir"
                mismapping_method = "align"
                align_backend     = "exact-hash"
                align_tau         = 0
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // One GROUPED_MISMAPPING replaces MINIMAP2_INDEX + MINIMAP2_ALLVSALL +
                // ALIGN_MISMAPPING: 10 - 2 = 8.
                { assert workflow.trace.succeeded().size() == 8 },
                { assert workflow.trace.tasks().any { it.name.contains('GROUPED_MISMAPPING') } },
                { assert workflow.trace.tasks().every { !it.name.contains('MINIMAP2') } },
                { assert workflow.trace.tasks().every { !it.name.contains('SIMULATE') } },
                { assert path("${params.outdir}/mismapping/groups.tsv").exists() }
            )
        }
    }

    test("kmer widens the duplicate groups to tau >= 1 - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input             = "${projectDir}/assets/samplesheet.example.yml"
                outdir            = "$outputDir"
                mismapping_method = "align"
                align_backend     = "kmer"
                align_tau         = 1
                align_distance_decay = 0.007
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().size() == 8 },
                { assert workflow.trace.tasks().any { it.name.contains('GROUPED_MISMAPPING') } },
                { assert workflow.trace.tasks().every { !it.name.contains('MINIMAP2') } }
            )
        }
    }

    test("the distance decay can be measured and fitted instead of guessed - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input             = "${projectDir}/assets/samplesheet.example.yml"
                outdir            = "$outputDir"
                mismapping_method = "align"
                align_backend     = "kmer"
                align_tau         = 1
                // Measured off the flat error model at build time, then fitted per
                // sample at inference — neither needs a number chosen by hand, and
                // neither trains anything.
                align_distance_decay = "auto"
                infer_distance_decay = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().size() == 8 },
                { assert workflow.trace.tasks().every { !it.name.contains('SKIVER') } },
                { assert workflow.trace.tasks().any { it.name.contains('GROUPED_MISMAPPING') } }
            )
        }
    }

    test("fitting the decay needs a matrix that recorded its distances - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input             = "${projectDir}/assets/samplesheet.example.yml"
                outdir            = "$outputDir"
                mismapping_method = "simulate"
                infer_distance_decay = true
            }
        }
        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('--infer_distance_decay needs') }
                         || workflow.errorReport.contains('--infer_distance_decay needs') }
            )
        }
    }

    test("pre-computed mis-mapping matrix skips its simulation flow - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input              = "${projectDir}/assets/samplesheet.example.yml"
                outdir             = "$outputDir"
                sim_error_model    = "trained"
                mismapping_matrix = "${projectDir}/tests/data/mismapping_matrix.csv"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // Matrix fingerprinting + canonical-bundle publication replace the
                // simulated branch. The pre-computed matrix skips training too.
                { assert workflow.trace.succeeded().size() == 7 },
                { assert workflow.trace.tasks().every { !it.name.contains('SIMULATE') } },
                { assert workflow.trace.tasks().every { !it.name.contains('SKIVER') } },
                { assert path("${params.outdir}/mismapping/groups.tsv").exists() },
                { assert !path("${params.outdir}/composition/demo/demo.mismapping_matrix.npz").exists() }
            )
        }
    }

    test("identical reference sets share one canonical mis-mapping matrix - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input = "${projectDir}/tests/data/samplesheet.two_same_refs.yml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().findAll { it.name.contains('SIMULATE_READS') }.size() == 1 },
                { assert workflow.trace.succeeded().findAll { it.name.contains('BUILD_MISMAPPING') }.size() == 1 },
                { assert path("${params.outdir}/mismapping/groups.tsv").exists() },
                { assert path("${params.outdir}/composition/demo_a/demo_a.inference_diagnostics.csv").exists() },
                { assert path("${params.outdir}/composition/demo_b/demo_b.inference_diagnostics.csv").exists() }
            )
        }
    }

    test("pooled trained model is built once per platform - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input = "${projectDir}/tests/data/samplesheet.two_same_refs.yml"
                outdir = "$outputDir"
                sim_error_model = "trained"
                trained_error_model_scope = "pooled"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().findAll { it.name.contains('POOL_TRAINING_READS') }.size() == 1 },
                { assert workflow.trace.succeeded().findAll { it.name.contains('SKIVER_TRAIN') }.size() == 1 },
                { assert workflow.trace.succeeded().findAll { it.name.contains('SIMULATE_READS') }.size() == 1 },
                { assert path("${params.outdir}/composition/demo_a/demo_a.inference_diagnostics.csv").exists() },
                { assert path("${params.outdir}/composition/demo_b/demo_b.inference_diagnostics.csv").exists() }
            )
        }
    }

    test("distinct reference sets build distinct matrices - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input = "${projectDir}/tests/data/samplesheet.two_distinct_refs.yml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().findAll { it.name.contains('SIMULATE_READS') }.size() == 2 },
                { assert workflow.trace.succeeded().findAll { it.name.contains('BUILD_MISMAPPING') }.size() == 2 }
            )
        }
    }
}
