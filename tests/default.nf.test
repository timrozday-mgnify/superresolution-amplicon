nextflow_pipeline {
    name "Test Pipeline SUPERRESOLUTION_AMPLICON"
    script "main.nf"

    tag "pipeline"

    test("single sample, flat error model (default) - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/assets/samplesheet.example.yml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // 1 sample: extraction, reference fingerprinting, observed mapping,
                // a canonical matrix build/publish path, inference, and fit check = 12.
                // No SKIVER_*: the error model is only used by the read simulator.
                { assert workflow.trace.succeeded().size() == 12 },
                { assert workflow.trace.tasks().every { !it.name.contains('SKIVER') } },
                { assert workflow.trace.tasks().every { !it.name.contains('BUILD_MISMAPPING') } },
                { assert workflow.trace.tasks().any { it.name.contains('PANEL_PREPARE') } },
                { assert path("${params.outdir}/composition/demo/demo.inferred_composition.csv").exists() },
                { assert path("${params.outdir}/composition/demo/demo.fit_diagnostics.json").exists() },
                { assert path("${params.outdir}/amplicons/demo_amplicons").exists() },
                { assert path("${params.outdir}/mapseq/demo/demo.obs.mseq.gz").exists() }
            )
        }
    }

    test("v4_group space publishes the group table - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input       = "${projectDir}/assets/samplesheet.example.yml"
                outdir      = "$outputDir"
                infer_space = "v4_group"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().size() == 12 },
                { assert path("${params.outdir}/composition/demo/demo.inferred_v4_groups.csv").exists() },
                { assert path("${params.outdir}/composition/demo/demo.inferred_composition.csv").exists() },
                { assert path("${params.outdir}/composition/demo/demo.fit_diagnostics.json").exists() }
            )
        }
    }

    test("panel_references builds a panel kernel instead of a square matrix - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/data/samplesheet.panel.yml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // The square matrix path (cluster, simulate, map, build, publish) is replaced
                // by prepare, home map, simulate, simulated map, kernel: still 12 tasks.
                { assert workflow.trace.succeeded().size() == 12 },
                { assert workflow.trace.tasks().every { !it.name.contains('BUILD_MISMAPPING') } },
                { assert workflow.trace.tasks().any { it.name.contains('MAPSEQ_PANEL_HOME') } },
                { assert path("${params.outdir}/composition/demo/demo.inferred_composition.csv").exists() },
                { assert path("${params.outdir}/composition/demo/demo.fit_diagnostics.json").exists() },
                { assert file("${params.outdir}/mismapping").listFiles().any {
                    it.name.startsWith('panel_') && new File(it, 'panel_sources.tsv').exists() } }
            )
        }
    }

    test("taxa-only and mixed panels each get their own panel kernel - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input    = "${projectDir}/tests/data/samplesheet.panel_taxa.yml"
                taxonomy = "${projectDir}/tests/data/refs.tax"
                outdir   = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().every { !it.name.contains('BUILD_MISMAPPING') } },
                // Different panels, so two kernels.
                { assert workflow.trace.tasks().count { it.name.contains('PANEL_PREPARE') } == 2 },
                { assert path("${params.outdir}/composition/taxa_only/taxa_only.inferred_composition.csv").exists() },
                { assert path("${params.outdir}/composition/mixed/mixed.fit_diagnostics.json").exists() }
            )
        }
    }

    test("panel_taxa without --taxonomy is refused - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/data/samplesheet.panel_taxa.yml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('panel_taxa needs --taxonomy') } }
            )
        }
    }

    test("a supplied mseq skips read mapping - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/data/samplesheet.supplied_mseq.yml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // The default single-sample run is 12 tasks; supplying the classification
                // drops READS_TO_FASTA and MAPSEQ_OBS.
                { assert workflow.trace.succeeded().size() == 10 },
                { assert workflow.trace.tasks().every { !it.name.contains('MAPSEQ_OBS') } },
                { assert workflow.trace.tasks().every { !it.name.contains('READS_TO_FASTA') } },
                { assert path("${params.outdir}/composition/demo/demo.inferred_composition.csv").exists() },
                { assert !path("${params.outdir}/mapseq/demo").exists() }
            )
        }
    }

    test("amplicon_cache keeps the extraction and clustering outside the work dir - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input          = "${projectDir}/assets/samplesheet.example.yml"
                outdir         = "$outputDir"
                amplicon_cache = "$outputDir/cache"
            }
        }
        then {
            // A second run pointed at the same cache skips both tasks ("Stored process").
            def cache = params.amplicon_cache
            def set = file(cache).listFiles()*.name.findAll { it.startsWith('refs_') }
            assertAll(
                { assert workflow.success },
                { assert set.size() == 1 },
                { assert path("${cache}/${set[0]}/amplicons/${set[0]}_amplicons/amplicons.fasta").exists() },
                { assert file("${cache}/${set[0]}").listFiles().any { d ->
                    d.name.startsWith('mapseq_') && new File(d, 'amplicons.fasta.mscluster').exists() } }
            )
        }
    }

    test("trained error model adds the skiver subworkflow - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input           = "${projectDir}/assets/samplesheet.example.yml"
                outdir          = "$outputDir"
                sim_error_model = "trained"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // + SKIVER_DUMP + SKIVER_TRAIN + SKIVER_REPORT = 15
                { assert workflow.trace.succeeded().size() == 15 }
            )
        }
    }

    test("paired samples merge their mates into one query - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input  = "${projectDir}/tests/data/samplesheet.paired.yml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().size() == 12 },
                { assert workflow.trace.tasks().any { it.name.contains('READS_TO_FASTA') } },
                { assert path("${params.outdir}/mapseq/paired_demo/paired_demo.obs.mseq.gz").exists() }
            )
        }
    }

    test("alignment builds a panel kernel without simulation - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input             = "${projectDir}/assets/samplesheet.example.yml"
                outdir            = "$outputDir"
                mismapping_method = "align"
                // Even asking for a trained model must not train one: nothing simulates
                // reads, so nothing needs an error model.
                sim_error_model   = "trained"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // Source home labels still come from MAPseq, but panel alignment replaces
                // the simulated-read and simulated-MAPseq tasks: 12 - 2 = 10.
                { assert workflow.trace.succeeded().size() == 10 },
                { assert workflow.trace.tasks().every { !it.name.contains('SIMULATE') } },
                { assert workflow.trace.tasks().every { !it.name.contains('SKIVER') } },
                { assert workflow.trace.tasks().any { it.name.contains('PANEL_ALIGN') } },
                { assert workflow.trace.tasks().every { !it.name.contains('BUILD_MISMAPPING') } }
            )
        }
    }

    test("fitting the decay needs a matrix that recorded its distances - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input             = "${projectDir}/assets/samplesheet.example.yml"
                outdir            = "$outputDir"
                mismapping_method = "simulate"
                infer_distance_decay = true
            }
        }
        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.any { it.contains('--infer_distance_decay needs') }
                         || workflow.errorReport.contains('--infer_distance_decay needs') }
            )
        }
    }

    test("identical reference sets share one panel kernel - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input = "${projectDir}/tests/data/samplesheet.two_same_refs.yml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                // One reference file: one extraction and one mapseq clustering, shared.
                { assert workflow.trace.succeeded().findAll { it.name.contains(':EXTRACT_AMPLICONS (') }.size() == 1 },
                { assert workflow.trace.succeeded().findAll { it.name.contains(':MAPSEQ_CLUSTER (') }.size() == 1 },
                { assert workflow.trace.succeeded().findAll { it.name.contains(':MATRIX_KEY (') }.size() == 2 },
                { assert workflow.trace.succeeded().findAll { it.name.contains(':MAPSEQ_OBS (') }.size() == 2 },
                { assert workflow.trace.succeeded().findAll { it.name.contains('SIMULATE_PANEL_READS') }.size() == 1 },
                { assert workflow.trace.succeeded().findAll { it.name.contains('PANEL_KERNEL') }.size() == 1 },
                // ...still published under each sample's own id.
                { assert path("${params.outdir}/amplicons/demo_a_amplicons/amplicons.fasta").exists() },
                { assert path("${params.outdir}/amplicons/demo_b_amplicons/amplicons.fasta").exists() },
                { assert path("${params.outdir}/composition/demo_a/demo_a.inference_diagnostics.csv").exists() },
                { assert path("${params.outdir}/composition/demo_b/demo_b.inference_diagnostics.csv").exists() }
            )
        }
    }

    test("pooled trained model is built once per platform - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input = "${projectDir}/tests/data/samplesheet.two_same_refs.yml"
                outdir = "$outputDir"
                sim_error_model = "trained"
                trained_error_model_scope = "pooled"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().findAll { it.name.contains('POOL_TRAINING_READS') }.size() == 1 },
                { assert workflow.trace.succeeded().findAll { it.name.contains('SKIVER_TRAIN') }.size() == 1 },
                { assert workflow.trace.succeeded().findAll { it.name.contains('SIMULATE_PANEL_READS') }.size() == 1 },
                { assert path("${params.outdir}/composition/demo_a/demo_a.inference_diagnostics.csv").exists() },
                { assert path("${params.outdir}/composition/demo_b/demo_b.inference_diagnostics.csv").exists() }
            )
        }
    }

    test("distinct reference sets build distinct panel kernels - stub") {
        tag "stub"
        options "-stub"
        when {
            params {
                input = "${projectDir}/tests/data/samplesheet.two_distinct_refs.yml"
                outdir = "$outputDir"
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().findAll { it.name.contains(':EXTRACT_AMPLICONS (') }.size() == 2 },
                { assert workflow.trace.succeeded().findAll { it.name.contains(':MAPSEQ_CLUSTER (') }.size() == 2 },
                { assert path("${params.outdir}/amplicons/demo_a_amplicons/amplicons.fasta").exists() },
                { assert path("${params.outdir}/amplicons/demo_b_amplicons/amplicons.fasta").exists() },
                { assert workflow.trace.succeeded().findAll { it.name.contains('SIMULATE_PANEL_READS') }.size() == 2 },
                { assert workflow.trace.succeeded().findAll { it.name.contains('PANEL_KERNEL') }.size() == 2 }
            )
        }
    }
}
