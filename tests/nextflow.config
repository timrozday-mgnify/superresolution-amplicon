// Container engine is chosen at invocation via `-profile docker` (real/e2e tests).
// With no profile, tasks run on the host — stub tests need no images. Cap resources
// so tasks fit on a laptop.
process {
    resourceLimits = [cpus: 4, memory: '8.GB', time: '1.h']
}

params {
    test_data_base = "${projectDir}/tests/data/"

    // Deterministic, fast error-model fit on tiny fixtures: a single small model,
    // no AIC search.
    error_model_components = 'AdditiveContext(3)'

    // The fixture is tiny, so skiver's auto-subsampling picks a huge rate and keeps
    // ~no k-mers. Force -c 1 (keep everything) for the test.
    skiver_dump_args = '-c 1'
}
